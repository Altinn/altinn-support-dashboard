{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Configuration": {
    "Production": {
      "DisplayName": "Produksjonsmiljø",
      "ThemeName": "Blue",
      "Ocp_Apim_Subscription_Key": "Defined in user-secrets",
      "BaseAddressAltinn3": "https://platform.altinn.no/",
      "ApiKey": "defined in user-secrets or key vault",
      "Timeout": 30,
      "MaskinportenSettings": {
        "ClientId": "defined in user-secrets or key vault",
        "Scope": "defined in user-secrets or key vault",
        "Environment": "prod",
        "EncodedJwk": "defined in user-secrets or key vault"
      }
    },
    "TT02": {
      "Name": "Testmiljø TT02",
      "ThemeName": "Orange",
      "Ocp_Apim_Subscription_Key": "Defined in user-secrets",
      "BaseAddressAltinn3": "https://platform.tt02.altinn.no/",
      "ApiKey": "defined in user-secrets or key vault",
      "Timeout": 30,
      "MaskinportenSettings": {
        "ClientId": "defined in user-secrets or key vault",
        "Scope": "defined in user-secrets or key vault",
        "Environment": "test",
        "EncodedJwk": "defined in user-secrets or key vault",
        "EnableDebugLogging": false
      }
    },

    "Correspondence": {
      "defaultResourceid": "ttd-asd-correspondence",
      "confidentialityResourceId": "ttd-asd-correspondence-confidentiality",
      "selfIdentifiedResourceId": "ttd-asd-correspondence-selfidentified",
      "SecurityLvl4ResourceId": "ttd-asd-correspondence-lvl4"
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "defined in user-secrets",
    "ClientId": "defined in user-secrets",
    "ClientSecret": "defined in user-secrets",
    "CallbackPath": "/signin-oidc"
  },

  "FeatureManagement": {
    "AzureEntra": false
  },

  "FeatureFlags": {
    "UseClientMocks": true
  },

  "RedirectConfiguration": {
    "AllowedUrls": ["https://localhost:5173"]
  },

  "Brreg": {
    "BaseUrl": "https://data.brreg.no/",
    "Timeout": 100
  },
  "BrregConfiguration": {
    "Production": {
      "BaseAddress": "https://data.brreg.no/",
      "Timeout": 100
    },
    "TT02": {
      "BaseAddress": "https://data.ppe.brreg.no/",
      "Timeout": 100
    }
  },
  "SsnTokenSettings": {
    "TokenExpiryMinutes": 15,
    "RemovalIntervalMinutes": 5
  },
  "LoggingConfiguration": {
    "TrackedEnvironments": ["Production", "TT02"]
  }
}
